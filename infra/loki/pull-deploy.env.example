# ~/.config/cellar-pull-deploy/config — SOURCED by scripts/deploy/pull-deploy.sh
# (bash syntax; mode 600). infra/loki/install-pull-deploy.sh copies this file
# there once and never overwrites it. Values here beat the environment.
# Paths and names only — no secret belongs in this file; secrets stay in
# the stack's env file (PULL_DEPLOY_ENV_FILE).

# What to deploy: the head of this branch of the public repository, once it is a
# fast-forward of what runs and every check-run on it is green.
#   main               every merge (what the old GitHub deploy job did)
#   production         only releases (release-please fast-forwards it; Vercel
#                      deploys the frontend from the same branch)
#   migrate-off-nhost  until the migration is merged (e4-decisions.md decision 15)
PULL_DEPLOY_BRANCH=main
#PULL_DEPLOY_REPO_URL=https://github.com/MrMint/cellar-assistant.git
#PULL_DEPLOY_GITHUB_REPO=MrMint/cellar-assistant

# Where the stack lives on this host (DEPLOYED_SHA, env/, state/, logs/,
# releases/, repo.git), its compose project, and its env file.
#PULL_DEPLOY_HOME=$HOME/cellar-prod
#PULL_DEPLOY_COMPOSE_PROJECT=cellar-prod
#PULL_DEPLOY_ENV_FILE=$HOME/cellar-prod/env/.env.prod
# Built images are <prefix>-api:<sha8> / <prefix>-actors:<sha8>.
#PULL_DEPLOY_IMAGE_PREFIX=cellar-prod

# The edge (scripts/deploy/edge.sh). REQUIRED: the host path nginx-proxy mounts
# at /etc/nginx/vhost.d (`docker inspect nginx-proxy`, the mount's Source).
NGINX_PROXY_VHOST_DIR=
#NGINX_PROXY_CONTAINER=nginx-proxy
#NGINX_PROXY_NETWORK=bridge
# 1 = edge.sh verify skips certificate checks (routing is what it proves; the
# certificate is deploy-loki.md §5's check). 0 once real certificates are issued.
#PULL_DEPLOY_EDGE_VERIFY_INSECURE=1

# The CI gate. By default every check-run on the commit must have completed as
# success, neutral or skipped, and at least one must exist. Comma-separated
# check-run names (as GitHub shows them, e.g. "images (api)"):
#   REQUIRED  must be present and success (absent = keep waiting)
#   IGNORE    never considered (e.g. a third-party app's check you do not gate on)
#PULL_DEPLOY_REQUIRED_CHECKS=
#PULL_DEPLOY_IGNORE_CHECKS=

# Release trees (and their images) kept, newest first. The running one and the
# one it replaced are never pruned, whatever this says.
#PULL_DEPLOY_KEEP_RELEASES=3
# nice(1) level for image builds; Loki shares its CPUs with other workloads.
#PULL_DEPLOY_NICE=10
