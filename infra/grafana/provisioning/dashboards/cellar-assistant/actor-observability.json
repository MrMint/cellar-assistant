    {
      "id": 26,
      "type": "stat",
      "title": "JWKS unavailable (24h)",
      "description": "Must read 0. Anything else is the condition rule api-jwks-unavailable pages on.",
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 9,
        "y": 72
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
