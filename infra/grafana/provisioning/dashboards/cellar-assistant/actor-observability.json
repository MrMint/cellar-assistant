    {
      "id": 25,
      "type": "timeseries",
      "title": "Events dropped by the api's 50/min cap",
      "description": "telemetry.suppressed carries the number of events the api dropped (telemetry_suppressed) per (event, class) window. Add these back to the panels above for true totals; anything here means a panel above is undercounting.",
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 0,
        "y": 72
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (telemetry_event) (sum_over_time({service_name=\"api\"} | event_name=\"telemetry.suppressed\" | unwrap telemetry_suppressed [$__interval]))",
          "legendFormat": "{{telemetry_event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
