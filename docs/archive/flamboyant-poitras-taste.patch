+"use client";
+
+import { Box, Typography } from "@mui/joy";
+import type { ReactNode } from "react";
+import { cardSx, tp } from "../tokens";
+
+type ModuleCardProps = {
+  title: string;
+  /** Optional decorator before the title (e.g. trophy icon). */
+  titleIcon?: ReactNode;
+  /** Right-aligned header content (caption, toggle, etc.). */
+  action?: ReactNode;
+  children: ReactNode;
+  /** Make the card a flex column (for charts that should fill height). */
+  fill?: boolean;
+};
+
+/** Standard dashboard card: hover-lifting surface with a header row. */
+export const ModuleCard = ({
+  title,
+  titleIcon,
+  action,
+  children,
+  fill,
+}: ModuleCardProps) => (
+  <Box
+    sx={{
+      ...cardSx,
+      ...(fill ? { display: "flex", flexDirection: "column" } : {}),
+    }}
+  >
+    <Box
+      sx={{
+        display: "flex",
+        alignItems: "center",
+        justifyContent: "space-between",
+        gap: "10px",
+        flexWrap: "wrap",
+        mb: "16px",
+      }}
+    >
+      <Box sx={{ display: "flex", alignItems: "center", gap: "9px" }}>
+        {titleIcon && (
+          <Box
+            sx={{
+              fontSize: "18px",
+              color: tp.color.amber,
+              display: "inline-flex",
+            }}
+          >
+            {titleIcon}
+          </Box>
+        )}
+        <Typography sx={{ fontSize: tp.fontSize.lg, fontWeight: 600 }}>
+          {title}
+        </Typography>
+      </Box>
+      {action}
+    </Box>
+    {children}
+  </Box>
+);
