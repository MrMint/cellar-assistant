+"use client";
+
+import { ITEM_TYPES, type ItemTypeValue } from "@cellar-assistant/shared";
+import { Box, Button, IconButton, Typography } from "@mui/joy";
+import { useRouter } from "next/navigation";
+import { MdArrowBack, MdShare } from "react-icons/md";
+import { formatItemType } from "@/utilities";
+import { TYPE_ICON } from "./icons";
+import { tp } from "./tokens";
+import type { Period } from "./types";
+
+type TasteProfileHeaderProps = {
+  type: ItemTypeValue;
+  onTypeChange: (t: ItemTypeValue) => void;
+  period: Period;
+  onPeriodChange: (p: Period) => void;
+  onShare?: () => void;
+};
+
+const PERIODS: { key: Period; label: string }[] = [
+  { key: "year", label: "This year" },
+  { key: "all", label: "All time" },
+];
+
+/** Sticky header: back, title, type tabs, period toggle, share. */
+export const TasteProfileHeader = ({
+  type,
+  onTypeChange,
+  period,
+  onPeriodChange,
+  onShare,
+}: TasteProfileHeaderProps) => {
+  const router = useRouter();
+
+  return (
+    <Box
+      sx={{
+        position: "sticky",
+        top: 0,
+        zIndex: 8,
+        background: "rgba(17,16,21,0.82)",
+        backdropFilter: "blur(16px) saturate(1.2)",
+        WebkitBackdropFilter: "blur(16px) saturate(1.2)",
+        borderBottom: `1px solid ${tp.color.divider}`,
+        padding: "14px 30px",
+        display: "flex",
+        alignItems: "center",
+        gap: "16px",
+        flexWrap: "wrap",
+      }}
+    >
+      <IconButton
+        variant="outlined"
+        color="neutral"
+        onClick={() => router.back()}
+        aria-label="Back"
+        sx={{ borderRadius: "9px" }}
+      >
+        <MdArrowBack />
+      </IconButton>
+      <Typography
+        sx={{
+          fontSize: tp.fontSize.xl,
+          fontWeight: 600,
+          letterSpacing: "-0.01em",
+        }}
+      >
+        Taste profile
+      </Typography>
+
+      {/* type tabs */}
+      <Box sx={{ display: "flex", gap: "7px", ml: "6px", flexWrap: "wrap" }}>
+        {ITEM_TYPES.map((t) => {
+          const on = t === type;
+          return (
+            <Box
+              key={t}
+              onClick={() => onTypeChange(t)}
+              role="tab"
+              aria-selected={on}
+              tabIndex={0}
+              onKeyDown={(e) => {
+                if (e.key === "Enter" || e.key === " ") {
+                  e.preventDefault();
+                  onTypeChange(t);
+                }
+              }}
+              sx={{
+                display: "flex",
+                alignItems: "center",
+                gap: "6px",
+                height: "32px",
+                padding: "0 12px",
+                borderRadius: tp.radius.pill,
+                fontSize: tp.fontSize.sm,
+                fontWeight: 600,
+                cursor: "pointer",
+                background: on ? tp.color.amber : "transparent",
+                color: on ? "#111015" : tp.color.textSecondary,
+                border: `1px solid ${on ? tp.color.amber : tp.color.border}`,
+                transition: `all ${tp.duration.fast} ${tp.ease.standard}`,
+              }}
+            >
+              <Box sx={{ fontSize: "14px", display: "inline-flex" }}>
+                {TYPE_ICON[t]}
+              </Box>
+              {formatItemType(t)}
+            </Box>
+          );
+        })}
+      </Box>
+
+      <Box
+        sx={{ display: "flex", alignItems: "center", gap: "12px", ml: "auto" }}
+      >
+        {/* period toggle */}
+        <Box
+          sx={{
+            display: "flex",
+            padding: "3px",
+            borderRadius: tp.radius.pill,
+            background: tp.color.bgLevel1,
+            border: `1px solid ${tp.color.border}`,
+          }}
+        >
+          {PERIODS.map((p) => {
+            const on = p.key === period;
+            return (
+              <Box
+                key={p.key}
+                onClick={() => onPeriodChange(p.key)}
+                role="tab"
+                aria-selected={on}
+                tabIndex={0}
+                onKeyDown={(e) => {
+                  if (e.key === "Enter" || e.key === " ") {
+                    e.preventDefault();
+                    onPeriodChange(p.key);
+                  }
+                }}
+                sx={{
+                  padding: "6px 14px",
+                  borderRadius: tp.radius.pill,
+                  fontSize: tp.fontSize.xs,
+                  fontWeight: 600,
+                  whiteSpace: "nowrap",
+                  cursor: "pointer",
+                  background: on ? "rgba(218,165,32,0.18)" : "transparent",
+                  color: on ? tp.color.amberLight : tp.color.textTertiary,
+                  transition: `all ${tp.duration.fast} ${tp.ease.standard}`,
+                }}
+              >
+                {p.label}
+              </Box>
+            );
+          })}
+        </Box>
+        <Button color="primary" startDecorator={<MdShare />} onClick={onShare}>
+          Share
+        </Button>
+      </Box>
+    </Box>
+  );
+};
