@@ -0,0 +1,68 @@
+"use client";
+
+/**
+ * Resolves the flavor fingerprint + archetype for the active source (A/B).
+ *
+ * - `heuristic` — computed on the server and passed in via `heuristicFlavor`.
+ * - `ai` — fetched via the `generateAiFlavor` server action; while it loads (or
+ *   if it fails) we fall back to the heuristic so the radar is never empty.
+ *   Results are cached per item type for the session.
+ */
+
+import type { ItemTypeValue } from "@cellar-assistant/shared";
+import { useEffect, useRef, useState } from "react";
+import { generateAiFlavor } from "@/app/actions/tasteProfile";
+import type { FlavorResult, FlavorSource, TasteProfileData } from "../types";
+
+type Result = { flavor: FlavorResult; aiLoading: boolean };
+
+export function useFlavorResult(
+  type: ItemTypeValue,
+  source: FlavorSource,
+  data: TasteProfileData | null,
+  heuristicFlavor: FlavorResult,
+): Result {
+  const [aiByType, setAiByType] = useState<
+    Partial<Record<ItemTypeValue, FlavorResult>>
+  >({});
+  const [aiLoading, setAiLoading] = useState(false);
+  const requested = useRef<Set<string>>(new Set());
+
+  useEffect(() => {
+    if (source !== "ai" || !data || data.styles.length === 0) return;
+    const key = type;
+    if (aiByType[key] || requested.current.has(key)) return;
+    requested.current.add(key);
+
+    let cancelled = false;
+    setAiLoading(true);
+    generateAiFlavor({
+      itemType: type,
+      styles: data.styles.map((s) => ({ name: s.name, count: s.count })),
+      topRated: data.topRated.map((r) => ({
+        name: r.name,
+        sub: r.sub,
+        score: r.score,
+      })),
+      regions: data.origin.map((o) => ({ name: o.name, count: o.count })),
+      avgScore: Number.parseFloat(data.scoreNow) || 0,
+    })
+      .then((res) => {
+        if (cancelled || !res) return;
+        setAiByType((prev) => ({ ...prev, [key]: res }));
+      })
+      .finally(() => {
+        if (!cancelled) setAiLoading(false);
+      });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [source, type, data, aiByType]);
+
+  if (source === "ai") {
+    const ai = aiByType[type];
+    return { flavor: ai ?? heuristicFlavor, aiLoading: aiLoading && !ai };
+  }
+  return { flavor: heuristicFlavor, aiLoading: false };
+}
