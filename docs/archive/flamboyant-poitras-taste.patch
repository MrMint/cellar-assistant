+/**
+ * Data contract for the Taste Profile dashboard.
+ *
+ * Both the mock data (Phase 1) and the live aggregations (Phase 2) produce these
+ * shapes, so the UI never has to change as the backing source evolves.
+ */
+
+import type { ItemTypeValue } from "@cellar-assistant/shared";
+
+export type Period = "year" | "all";
+
+/** How the flavor fingerprint + archetype are produced (A/B). */
+export type FlavorSource = "heuristic" | "ai";
+
+export type StatTile = { value: string; label: string };
+
+export type StyleRow = {
+  name: string;
+  /** Bar color for this style. */
+  color: string;
+  count: number;
+};
+
+export type FlavorAxis = {
+  name: string;
+  /** 0–100, this member. */
+  you: number;
+  /** 0–100, community average. */
+  avg: number;
+};
+
+export type TopRatedItem = {
+  rank: number;
+  name: string;
+  /** `Producer · City, ST · Style` */
+  sub: string;
+  /** 0–5 */
+  score: number;
+};
+
+export type Insight = {
+  /** Icon key resolved by the insights strip. */
+  icon: "trophy" | "bars" | "search";
+  title: string;
+  text: string;
+};
+
+export type CadenceMonth = {
+  /** Single-letter month label. */
+  label: string;
+  value: number;
+  peak?: boolean;
+};
+
+export type OriginRow = { name: string; count: number };
+
+export type ScorePoint = { label: string; value: number };
+
+export type Archetype = {
+  /** e.g. "The Hop-Forward Wanderer" */
+  title: string;
+  description: string;
+};
+
+/** The full per-(type, period) dataset that drives the beer-style dashboard. */
+export type TasteProfileData = {
+  archetype: Archetype;
+  statTiles: StatTile[];
+  insights: Insight[];
+  flavorAxes: FlavorAxis[];
+  styles: StyleRow[];
+  topRated: TopRatedItem[];
+  scoreNow: string;
+  scoreDelta: string;
+  scoreTrend: ScorePoint[];
+  cadence: CadenceMonth[];
+  cadenceCaption: string;
+  origin: OriginRow[];
+  originCaption: string;
+};
+
+/** State for a type that has not unlocked its profile yet. */
+export type UnlockInfo = {
+  type: ItemTypeValue;
+  logged: number;
+  goal: number;
+};
+
+/**
+ * The flavor fingerprint + archetype, produced either heuristically or by AI.
+ * Both A/B sources resolve to this shape.
+ */
+export type FlavorResult = {
+  axes: FlavorAxis[];
+  archetype: Archetype;
+};
