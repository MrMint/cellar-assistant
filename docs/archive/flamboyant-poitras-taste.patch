diff --git a/functions/generateTasteProfile/index.ts b/functions/generateTasteProfile/index.ts
new file mode 100644
index 00000000..4f955c04
--- /dev/null
+++ b/functions/generateTasteProfile/index.ts
@@ -0,0 +1,204 @@
+import type { Request, Response } from "express";
+import type { JSONSchema7 } from "json-schema";
+import { createAIProvider } from "../_utils/ai-providers/factory";
+
+const { NHOST_WEBHOOK_SECRET } = process.env;
+
+interface StyleInput {
+  name: string;
+  count: number;
+}
+
+interface TopRatedInput {
+  name: string;
+  sub: string;
+  score: number;
+}
+
+interface RegionInput {
+  name: string;
+  count: number;
+}
+
+interface TasteProfileRequest {
+  itemType: string;
+  axisNames: string[];
+  styles: StyleInput[];
+  topRated: TopRatedInput[];
+  regions: RegionInput[];
+  avgScore: number;
+}
+
+function isStringArray(value: unknown): value is string[] {
+  return (
+    Array.isArray(value) && value.every((entry) => typeof entry === "string")
+  );
+}
+
+function parseRequest(body: unknown): TasteProfileRequest {
+  const raw = (body ?? {}) as Record<string, unknown>;
+
+  const itemType = typeof raw.itemType === "string" ? raw.itemType : "";
+  const axisNames = isStringArray(raw.axisNames) ? raw.axisNames : [];
+
+  if (!itemType) throw new Error("itemType is required");
+  if (axisNames.length === 0) throw new Error("axisNames is required");
+
+  const styles = Array.isArray(raw.styles)
+    ? (raw.styles as StyleInput[]).map((s) => ({
+        name: String(s?.name ?? ""),
+        count: Number(s?.count ?? 0),
+      }))
+    : [];
+
+  const topRated = Array.isArray(raw.topRated)
+    ? (raw.topRated as TopRatedInput[]).map((t) => ({
+        name: String(t?.name ?? ""),
+        sub: String(t?.sub ?? ""),
+        score: Number(t?.score ?? 0),
+      }))
+    : [];
+
+  const regions = Array.isArray(raw.regions)
+    ? (raw.regions as RegionInput[]).map((r) => ({
+        name: String(r?.name ?? ""),
+        count: Number(r?.count ?? 0),
+      }))
+    : [];
+
+  const avgScore = Number(raw.avgScore ?? 0);
+
+  return { itemType, axisNames, styles, topRated, regions, avgScore };
+}
+
+function buildSchema(axisNames: string[]): JSONSchema7 {
+  return {
+    type: "object",
+    properties: {
+      axes: {
+        type: "array",
+        description: `One entry per flavor axis. Provide exactly these axes by name: ${axisNames.join(", ")}.`,
+        items: {
+          type: "object",
+          properties: {
+            name: {
+              type: "string",
+              description: `The flavor axis name. Must be one of: ${axisNames.join(", ")}.`,
+              enum: axisNames,
+            },
+            you: {
+              type: "integer",
+              minimum: 0,
+              maximum: 100,
+              description:
+                "This member's strength on this flavor axis, 0 (none) to 100 (dominant).",
+            },
+          },
+          required: ["name", "you"],
+        },
+      },
+      archetype: {
+        type: "object",
+        properties: {
+          title: {
+            type: "string",
+            description:
+              "A short, fun taste-identity title in title case, e.g. 'The Hop-Forward Wanderer'.",
+          },
+          description: {
+            type: "string",
+            description:
+              "A 1-2 sentence, second-person description of this taste identity. Plain text only.",
+          },
+        },
+        required: ["title", "description"],
+      },
+    },
+    required: ["axes", "archetype"],
+  };
+}
+
+function buildPrompt(request: TasteProfileRequest): string {
+  const { itemType, axisNames, styles, topRated, regions, avgScore } = request;
+
+  const stylesSummary =
+    styles.length > 0
+      ? styles.map((s) => `- ${s.name} (logged ${s.count}x)`).join("\n")
+      : "- (no styles logged)";
+
+  const topRatedSummary =
+    topRated.length > 0
+      ? topRated
+          .map((t) => `- ${t.name} — ${t.sub} (rated ${t.score}/5)`)
+          .join("\n")
+      : "- (no rated items)";
+
+  const regionsSummary =
+    regions.length > 0
+      ? regions.map((r) => `- ${r.name} (${r.count})`).join("\n")
+      : "- (no regions logged)";
+
+  return `You are a perceptive ${itemType} taste analyst. Based on what a member has logged and rated, infer a flavor fingerprint that captures their personal palate.
+
+## The member's ${itemType} collection
+
+### Styles logged (most to least)
+${stylesSummary}
+
+### Top-rated items
+${topRatedSummary}
+
+### Regions / origins
+${regionsSummary}
+
+### Average rating across the collection
+${avgScore.toFixed(2)} / 5
+
+## What to produce
+
+1. A flavor fingerprint scored 0–100 on EXACTLY these axes (one entry per axis, using the exact names): ${axisNames.join(", ")}.
+   - 0 means this trait is essentially absent from their palate; 100 means it dominates.
+   - Weight the scores toward styles they log most often and items they rate highest.
+   - Use the full 0–100 range; avoid clustering everything around the middle.
+2. A short, fun "taste identity" archetype:
+   - title: a catchy title in title case (e.g. "The Hop-Forward Wanderer").
+   - description: 1–2 sentences, second person, grounded in their actual styles/ratings. Plain text only, no markdown.
+
+Return only the structured fields requested.`;
+}
+
+export default async function generateTasteProfile(
+  req: Request,
+  res: Response,
+) {
+  try {
+    if (req.method === "GET") return res.status(200).send();
+    if (req.method !== "POST") return res.status(405).send();
+    if (req.headers["nhost-webhook-secret"] !== NHOST_WEBHOOK_SECRET) {
+      return res.status(400).json({ error: "Unauthorized" });
+    }
+
+    const request = parseRequest(req.body);
+
+    const aiProvider = await createAIProvider();
+    const prompt = buildPrompt(request);
+    const schema = buildSchema(request.axisNames);
+
+    const aiResponse = await aiProvider.generateContent(
+      { prompt, schema },
+      "low",
+    );
+
+    const parsed = JSON.parse(aiResponse.content) as {
+      axes: { name: string; you: number }[];
+      archetype: { title: string; description: string };
+    };
+
+    return res.status(200).json(parsed);
+  } catch (error) {
+    console.error("[generateTasteProfile] Error:", error);
+    return res.status(500).json({
+      error: error instanceof Error ? error.message : "Unknown error occurred",
+    });
+  }
+}
