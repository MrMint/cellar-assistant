+import { ITEM_TYPES, type ItemTypeValue } from "@cellar-assistant/shared";
+import { loadTasteProfile } from "@/components/taste-profile/data/loadTasteProfile";
+import { TasteProfileClient } from "@/components/taste-profile/TasteProfileClient";
+import type { Period } from "@/components/taste-profile/types";
+import { getServerUserId } from "@/utilities/auth-server";
+
+function parseType(value: string | undefined): ItemTypeValue {
+  const upper = (value ?? "").toUpperCase();
+  return (ITEM_TYPES as readonly string[]).includes(upper)
+    ? (upper as ItemTypeValue)
+    : "BEER";
+}
+
+function parsePeriod(value: string | undefined): Period {
+  return value === "all" ? "all" : "year";
+}
+
+export default async function TasteProfilePage({
+  searchParams,
+}: {
+  searchParams: Promise<{ type?: string; period?: string }>;
+}) {
+  const { type: typeParam, period: periodParam } = await searchParams;
+  const type = parseType(typeParam);
+  const period = parsePeriod(periodParam);
+
+  const userId = await getServerUserId();
+  const { data, heuristicFlavor, countsByType } = await loadTasteProfile(
+    userId,
+    type,
+    period,
+  );
+
+  return (
+    <TasteProfileClient
+      type={type}
+      period={period}
+      data={data}
+      heuristicFlavor={heuristicFlavor}
+      countsByType={countsByType}
+    />
+  );
+}
diff --git a/src/app/actions/tasteProfile.ts b/src/app/actions/tasteProfile.ts
new file mode 100644
index 00000000..41fafcce
--- /dev/null
+++ b/src/app/actions/tasteProfile.ts
@@ -0,0 +1,119 @@
+"use server";
+
+import {
+  COMMUNITY_BASELINE,
+  FLAVOR_AXES,
+} from "@/components/taste-profile/flavor/heuristic";
+import type {
+  Archetype,
+  FlavorAxis,
+  FlavorResult,
+} from "@/components/taste-profile/types";
+
+interface GenerateAiFlavorInput {
+  itemType: string;
+  styles: { name: string; count: number }[];
+  topRated: { name: string; sub: string; score: number }[];
+  regions: { name: string; count: number }[];
+  avgScore: number;
+}
+
+interface AiFlavorResponse {
+  axes: { name: string; you: number }[];
+  archetype: Archetype;
+}
+
+const DEFAULT_FUNCTION_URL = "https://local.functions.nhost.run";
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, value));
+}
+
+function isAiFlavorResponse(value: unknown): value is AiFlavorResponse {
+  if (!value || typeof value !== "object") return false;
+  const candidate = value as Record<string, unknown>;
+
+  if (!Array.isArray(candidate.axes)) return false;
+  const axesValid = candidate.axes.every(
+    (axis) =>
+      axis &&
+      typeof axis === "object" &&
+      typeof (axis as Record<string, unknown>).name === "string" &&
+      typeof (axis as Record<string, unknown>).you === "number",
+  );
+  if (!axesValid) return false;
+
+  const archetype = candidate.archetype as Record<string, unknown> | undefined;
+  if (
+    !archetype ||
+    typeof archetype !== "object" ||
+    typeof archetype.title !== "string" ||
+    typeof archetype.description !== "string"
+  ) {
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * AI-sourced flavor fingerprint + archetype (A/B option B).
+ *
+ * Calls the `generateTasteProfile` serverless function and maps its output to a
+ * `FlavorResult`, attaching the community baseline as each axis's `avg`. Returns
+ * `null` on any failure so the UI can fall back to the heuristic source.
+ */
+export async function generateAiFlavor(
+  input: GenerateAiFlavorInput,
+): Promise<FlavorResult | null> {
+  try {
+    const functionUrl = process.env.NHOST_FUNCTION_URL ?? DEFAULT_FUNCTION_URL;
+
+    const response = await fetch(
+      `${functionUrl}/v1/functions/generateTasteProfile`,
+      {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          "nhost-webhook-secret": process.env.NHOST_WEBHOOK_SECRET ?? "",
+        },
+        body: JSON.stringify({
+          itemType: input.itemType,
+          axisNames: [...FLAVOR_AXES],
+          styles: input.styles,
+          topRated: input.topRated,
+          regions: input.regions,
+          avgScore: input.avgScore,
+        }),
+      },
+    );
+
+    if (!response.ok) {
+      console.error(`generateTasteProfile returned ${response.status}`);
+      return null;
+    }
+
+    const data: unknown = await response.json();
+    if (!isAiFlavorResponse(data)) {
+      console.error("generateTasteProfile returned unexpected shape");
+      return null;
+    }
+
+    const byName = new Map(data.axes.map((axis) => [axis.name, axis.you]));
+
+    const axes: FlavorAxis[] = FLAVOR_AXES.map((name) => {
+      const baseline = COMMUNITY_BASELINE[name];
+      const you = byName.get(name);
+      return {
+        name,
+        you: you === undefined ? baseline : clamp(Math.round(you), 0, 100),
+        avg: baseline,
+      };
+    });
+
+    return { axes, archetype: data.archetype };
+  } catch (error) {
+    console.error("Failed to generate AI flavor profile:", error);
+    return null;
+  }
+}
diff --git a/src/components/taste-profile/TasteProfileClient.tsx b/src/components/taste-profile/TasteProfileClient.tsx
