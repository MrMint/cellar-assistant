@@ -0,0 +1,125 @@
+"use client";
+
+import { Box, Button, Typography } from "@mui/joy";
+import { MdAdd } from "react-icons/md";
+import { formatItemType } from "@/utilities";
+import { TYPE_ICON } from "../icons";
+import { ITEM_TYPE_COLOR, ITEM_TYPE_TINT, tp } from "../tokens";
+import type { UnlockInfo } from "../types";
+
+type UnlockStateProps = {
+  info: UnlockInfo;
+  onAdd?: () => void;
+};
+
+/** Shown for a type that has not logged enough items to unlock its profile. */
+export const UnlockState = ({ info, onAdd }: UnlockStateProps) => {
+  const { type, logged, goal } = info;
+  const label = formatItemType(type).toLowerCase();
+  const zero = logged === 0;
+  const remaining = Math.max(0, goal - logged);
+  const pct = Math.round((Math.min(logged, goal) / goal) * 100);
+
+  return (
+    <Box
+      sx={{
+        minHeight: "520px",
+        display: "flex",
+        alignItems: "center",
+        justifyContent: "center",
+      }}
+    >
+      <Box
+        sx={{
+          maxWidth: "440px",
+          textAlign: "center",
+          display: "flex",
+          flexDirection: "column",
+          alignItems: "center",
+          gap: "18px",
+          padding: "40px",
+          borderRadius: "18px",
+          background: tp.color.bgLevel1,
+          border: `1px solid ${tp.color.border}`,
+        }}
+      >
+        <Box
+          sx={{
+            width: "84px",
+            height: "84px",
+            borderRadius: "22px",
+            background: ITEM_TYPE_TINT[type],
+            color: ITEM_TYPE_COLOR[type],
+            display: "inline-flex",
+            alignItems: "center",
+            justifyContent: "center",
+            fontSize: "42px",
+          }}
+        >
+          {TYPE_ICON[type]}
+        </Box>
+        <Box>
+          <Typography
+            sx={{
+              margin: "0 0 8px",
+              fontSize: tp.fontSize.xl2,
+              fontWeight: 700,
+              letterSpacing: "-0.02em",
+            }}
+          >
+            {zero
+              ? `No ${label} logged yet`
+              : `Your ${label} profile is still pouring`}
+          </Typography>
+          <Typography
+            sx={{
+              margin: 0,
+              color: tp.color.textSecondary,
+              fontSize: "15px",
+              lineHeight: 1.55,
+            }}
+          >
+            {zero
+              ? `Scan a label or add your first ${label} to start building a taste profile.`
+              : `You have logged ${logged} ${label}s. About ${remaining} more unlocks your full ${label} taste profile.`}
+          </Typography>
+        </Box>
+        <Box sx={{ width: "100%", maxWidth: "300px" }}>
+          <Box
+            sx={{
+              display: "flex",
+              justifyContent: "space-between",
+              fontSize: tp.fontSize.xs,
+              color: tp.color.textTertiary,
+              mb: "6px",
+            }}
+          >
+            <span>{logged} logged</span>
+            <span>{goal} to unlock</span>
+          </Box>
+          <Box
+            sx={{
+              height: "8px",
+              borderRadius: tp.radius.pill,
+              background: "rgba(255,255,255,0.06)",
+              overflow: "hidden",
+            }}
+          >
+            <Box
+              sx={{
+                height: "100%",
+                borderRadius: tp.radius.pill,
+                width: `${pct}%`,
+                background: ITEM_TYPE_COLOR[type],
+                transition: `width ${tp.duration.slow} ${tp.ease.out}`,
+              }}
+            />
+          </Box>
+        </Box>
+        <Button color="primary" startDecorator={<MdAdd />} onClick={onAdd}>
+          Add {label}
+        </Button>
+      </Box>
+    </Box>
+  );
+};
diff --git a/src/components/taste-profile/tokens.ts b/src/components/taste-profile/tokens.ts
new file mode 100644
index 00000000..d7f3c1fa
--- /dev/null
+++ b/src/components/taste-profile/tokens.ts
@@ -0,0 +1,120 @@
+/**
+ * Design tokens for the Taste Profile feature.
+ *
+ * The design handoff references a `--ca-*` CSS-variable system that does not
+ * exist in this codebase. Where a value maps to the live Joy theme it is noted;
+ * the rest (amber accent, surface levels, per-type accents, shadows, motion) are
+ * literal values from the handoff that the theme does not provide.
+ *
+ * Use these constants in `sx`/`style` props so the dashboard stays faithful to
+ * the spec without polluting the global theme.
+ */
+
+import type { ItemTypeValue } from "@cellar-assistant/shared";
+
+export const tp = {
+  color: {
+    // Canvas / surfaces
+    bgBody: "#111015", // theme.palette.background.body
+    bgLevel1: "#1E1C24",
+    bgLevel2: "#27242F",
+    bgSurface: "#18171D",
+    bgPopup: "#1A1820",
+
+    // Text — mirror theme.palette.neutral 100/300/400
+    textPrimary: "#ECEAEF",
+    textSecondary: "#9E97B1",
+    textTertiary: "#786E91",
+
+    // Lines
+    border: "rgba(255,255,255,0.10)",
+    borderStrong: "rgba(255,255,255,0.18)",
+    divider: "rgba(255,255,255,0.08)",
+
+    // Primary (teal) — mirror theme.palette.primary 300/400/500/600
+    primary300: "#afcccf",
+    primary400: "#8fb8bc",
+    primary500: "#70a3a9",
+    primary600: "#568a8f",
+
+    // Beer accent (amber) — not in theme
+    amber: "#DAA520",
+    amberLight: "#EBC56A",
+    amberLight2: "#F0CE78",
+    amberDark: "#9A5B13",
+
+    success300: "#51BC51",
+    starGold: "#ffba26",
+  },
+
+  radius: {
+    card: "12px", // --ca-radius-lg
+    banner: "14px",
+    pill: "999px",
+    navSlot: "10px",
+    statTile: "11px",
+  },
+
+  shadow: {
+    sm: "0 1px 2px rgba(0,0,0,.4)",
+    md: "0 2px 8px rgba(0,0,0,.5), 0 6px 16px rgba(0,0,0,.35)",
+    lg: "0 4px 12px rgba(0,0,0,.55), 0 12px 28px rgba(0,0,0,.4)",
+  },
+
+  duration: {
+    fast: "120ms",
+    base: "200ms",
+    slow: "320ms",
+  },
+
+  ease: {
+    standard: "cubic-bezier(0.4,0,0.2,1)",
+    out: "cubic-bezier(0.16,1,0.3,1)",
+  },
+
+  fontSize: {
+    xs: "12px",
+    sm: "13px",
+    md: "14px",
+    lg: "18px",
+    xl: "20px",
+    xl2: "24px",
+    xl3: "30px",
+  },
+} as const;
+
+/** Per-item-type accent color (handoff "item-type colors"). */
+export const ITEM_TYPE_COLOR: Record<ItemTypeValue, string> = {
+  WINE: "#8B0000",
+  BEER: "#DAA520",
+  SPIRIT: "#607D8B",
+  COFFEE: "#8B4513",
+  SAKE: "#7B1FA2",
+  TEA: "#2E7D32",
+};
+
+/** Soft pastel backing used behind illustrations / unlock icons (~16% alpha). */
+export const ITEM_TYPE_TINT: Record<ItemTypeValue, string> = {
+  WINE: "rgba(139,0,0,0.16)",
+  BEER: "rgba(218,165,32,0.16)",
+  SPIRIT: "rgba(96,125,139,0.16)",
+  COFFEE: "rgba(139,69,19,0.16)",
+  SAKE: "rgba(123,31,162,0.16)",
+  TEA: "rgba(46,125,50,0.16)",
+};
+
