@@ -0,0 +1,57 @@
+"use client";
+
+import { Box } from "@mui/joy";
+import { MdStar, MdStarHalf, MdStarOutline } from "react-icons/md";
+import { tp } from "../tokens";
+
+type StarRatingProps = {
+  /** 0–5, half-star resolution. */
+  value: number;
+  size?: number;
+  showValue?: boolean;
+  /** Decimal places when showing the value. */
+  precision?: number;
+};
+
+/**
+ * Gold 5-star rating. Joy has no Rating component, so this is a small custom
+ * display built from react-icons stars (matching how the app renders MdStar).
+ */
+export const StarRating = ({
+  value,
+  size = 15,
+  showValue = true,
+  precision = 2,
+}: StarRatingProps) => {
+  const clamped = Math.max(0, Math.min(5, value));
+
+  return (
+    <Box
+      sx={{ display: "inline-flex", alignItems: "center", gap: "5px" }}
+      aria-label={`${clamped.toFixed(precision)} out of 5 stars`}
+    >
+      <Box sx={{ display: "inline-flex", color: tp.color.starGold }}>
+        {Array.from({ length: 5 }, (_, i) => {
+          const filled = clamped >= i + 1;
+          const half = !filled && clamped >= i + 0.5;
+          const Icon = filled ? MdStar : half ? MdStarHalf : MdStarOutline;
+          // biome-ignore lint/suspicious/noArrayIndexKey: fixed 5-star positional series
+          return <Icon key={i} size={size} />;
+        })}
+      </Box>
+      {showValue && (
+        <Box
+          component="span"
+          sx={{
+            fontSize: `${Math.max(11, size - 2)}px`,
+            fontWeight: 700,
+            fontVariantNumeric: "tabular-nums",
+            color: tp.color.textPrimary,
+          }}
+        >
+          {clamped.toFixed(precision)}
+        </Box>
+      )}
+    </Box>
+  );
+};
diff --git a/src/components/taste-profile/data/buildTasteProfile.ts b/src/components/taste-profile/data/buildTasteProfile.ts
new file mode 100644
index 00000000..5a77fea2
--- /dev/null
+++ b/src/components/taste-profile/data/buildTasteProfile.ts
@@ -0,0 +1,485 @@
+/**
+ * Pure aggregation layer for the Taste Profile dashboard (Phase 2).
+ *
+ * `buildTasteProfile` turns a member's normalized review history into the typed
+ * {@link TasteProfileData} contract the UI already consumes. It is intentionally
+ * side-effect free (aside from the injectable `now`) so it can be unit-tested and
+ * reused on the server.
+ *
+ * NOTE: `flavorAxes` and `archetype` are deliberately left as neutral
+ * placeholders here — the flavor fingerprint + archetype are produced by Phase 3
+ * (see `flavor/heuristic.ts`) and merged in by the caller. Do not compute them
+ * in this file.
+ */
+
+import { formatEnum, type ItemTypeValue } from "@cellar-assistant/shared";
+import { ITEM_TYPE_COLOR } from "../tokens";
+import type {
+  Insight,
+  Period,
+  StyleRow,
+  TasteProfileData,
+  UnlockInfo,
+} from "../types";
+
+/**
+ * A single review flattened to the fields the aggregator needs, regardless of
+ * the underlying item type. Produced by the data hook from the per-type query.
+ */
+export type RawReview = {
+  /** 0.5–5 */
+  score: number;
+  /** ISO timestamp (timestamptz). */
+  createdAt: string;
+  /** Item display name. */
+  name: string;
+  /** Raw style/category enum or string (type-specific), if present. */
+  style?: string | null;
+  /** Producer / brand name, if present. */
+  producer?: string | null;
+  /** Region (free text), if present. */
+  region?: string | null;
+  /** Country enum, if present. */
+  country?: string | null;
+};
+
+const PERIOD_NOTE: Record<Period, string> = {
+  year: "this year",
+  all: "all time",
+};
+
+/** Single-letter month labels, indexed by JS month (0 = Jan). */
+const MONTH_LETTERS = [
+  "J",
+  "F",
+  "M",
+  "A",
+  "M",
+  "J",
+  "J",
+  "A",
+  "S",
+  "O",
+  "N",
+  "D",
+];
+
+/** Short month names for trend labels (0 = Jan). */
+const MONTH_SHORT = [
+  "Jan",
+  "Feb",
+  "Mar",
+  "Apr",
+  "May",
+  "Jun",
+  "Jul",
+  "Aug",
+  "Sep",
+  "Oct",
+  "Nov",
+  "Dec",
+];
+
+/**
+ * Style-bar palette. Reuses the per-type accent as the lead color and rotates
+ * through a small set of warm/cool supporting hues so adjacent bars stay
+ * distinguishable. Mirrors the spirit of the mock's hand-picked colors without
+ * needing a per-style lookup table.
+ */
+const STYLE_PALETTE = [
+  "#E8A33D",
+  "#DAA520",
+  "#7A4A2B",
+  "#E8C547",
+  "#C9A24B",
+  "#9A5B13",
+  "#C97B84",
+  "#8FB8BC",
+  "#70A3A9",
+  "#568A8F",
+];
+
+function styleColor(type: ItemTypeValue, index: number): string {
+  if (index === 0) return ITEM_TYPE_COLOR[type];
+  return STYLE_PALETTE[index % STYLE_PALETTE.length] ?? ITEM_TYPE_COLOR[type];
+}
+
+/** Human label for the per-type "logged" stat tile. */
+const LOGGED_LABEL: Record<ItemTypeValue, string> = {
+  BEER: "Beers logged",
+  WINE: "Wines logged",
+  SPIRIT: "Spirits logged",
+  COFFEE: "Coffees logged",
+  SAKE: "Sakes logged",
+  TEA: "Teas logged",
+};
+
+/** Human label for the per-type "distinct producers" stat tile. */
+const PRODUCER_LABEL: Record<ItemTypeValue, string> = {
+  BEER: "Breweries",
+  WINE: "Wineries",
+  SPIRIT: "Distillers",
+  COFFEE: "Roasters",
+  SAKE: "Breweries",
+  TEA: "Producers",
+};
+
+function round2(value: number): string {
+  return (Math.round(value * 100) / 100).toFixed(2);
+}
+
+function avg(values: number[]): number {
+  if (values.length === 0) return 0;
+  return values.reduce((sum, v) => sum + v, 0) / values.length;
+}
+
+/** Pluralize "region"/"country" counts for captions (handles consonant+y → ies). */
+function plural(count: number, noun: string): string {
+  if (count === 1) return `${count} ${noun}`;
+  const pluralized = /[^aeiou]y$/.test(noun)
+    ? `${noun.slice(0, -1)}ies`
+    : `${noun}s`;
+  return `${count} ${pluralized}`;
+}
+
+function emptyData(type: ItemTypeValue, period: Period): TasteProfileData {
+  return {
+    archetype: { title: "", description: "" },
+    statTiles: [
+      { value: "0", label: LOGGED_LABEL[type] },
+      { value: "0", label: PRODUCER_LABEL[type] },
+      { value: "0", label: "Styles" },
+      { value: "0.00", label: "Avg score" },
+    ],
+    insights: [],
+    flavorAxes: [],
+    styles: [],
+    topRated: [],
+    scoreNow: "0.00",
+    scoreDelta: "",
+    scoreTrend: [],
+    cadence: [],
+    cadenceCaption: PERIOD_NOTE[period],
+    origin: [],
+    originCaption: "",
+  };
+}
+
+/** Filter reviews down to the active period relative to `now`. */
+function filterByPeriod(
+  reviews: RawReview[],
+  period: Period,
+  now: Date,
+): RawReview[] {
+  if (period === "all") return reviews;
+  // "year" == trailing 12 months.
+  const cutoff = new Date(now);
+  cutoff.setFullYear(cutoff.getFullYear() - 1);
+  return reviews.filter((r) => {
+    const d = new Date(r.createdAt);
+    return !Number.isNaN(d.getTime()) && d >= cutoff;
+  });
+}
+
+/** Top styles by count, colored, descending. */
+function buildStyles(
+  reviews: RawReview[],
+  type: ItemTypeValue,
+  limit = 7,
+): StyleRow[] {
+  const counts = new Map<string, number>();
+  for (const r of reviews) {
+    const label = formatEnum(r.style ?? undefined);
+    if (!label) continue;
+    counts.set(label, (counts.get(label) ?? 0) + 1);
+  }
+  return Array.from(counts.entries())
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, limit)
+    .map(([name, count], index) => ({
+      name,
+      color: styleColor(type, index),
+      count,
+    }));
+}
+
+/** Top rated items by the member's own score, with a `Producer · Region · Style` subtitle. */
+function buildTopRated(reviews: RawReview[]) {
+  return [...reviews]
+    .sort((a, b) => b.score - a.score)
+    .slice(0, 5)
+    .map((r, index) => {
+      const parts = [
+        r.producer ?? undefined,
+        r.region ?? formatEnum(r.country ?? undefined) ?? undefined,
+        formatEnum(r.style ?? undefined),
+      ].filter((p): p is string => Boolean(p));
+      return {
+        rank: index + 1,
+        name: r.name,
+        sub: parts.join(" · "),
+        score: r.score,
+      };
+    });
+}
+
+/** Average score bucketed by month (year) or year (all), oldest → newest. */
+function buildScoreTrend(reviews: RawReview[], period: Period) {
+  if (reviews.length === 0) return [];
+
+  if (period === "all") {
+    const byYear = new Map<number, number[]>();
+    for (const r of reviews) {
+      const d = new Date(r.createdAt);
+      if (Number.isNaN(d.getTime())) continue;
+      const y = d.getFullYear();
+      const bucket = byYear.get(y) ?? [];
+      bucket.push(r.score);
+      byYear.set(y, bucket);
+    }
+    return Array.from(byYear.entries())
+      .sort((a, b) => a[0] - b[0])
+      .map(([year, scores]) => ({
+        label: String(year),
+        value: Math.round(avg(scores) * 100) / 100,
+      }));
+  }
+
+  // year: last ~6 months that have data, by month.
+  const byMonth = new Map<string, { date: Date; scores: number[] }>();
+  for (const r of reviews) {
+    const d = new Date(r.createdAt);
+    if (Number.isNaN(d.getTime())) continue;
+    const key = `${d.getFullYear()}-${d.getMonth()}`;
+    const bucket = byMonth.get(key) ?? {
+      date: new Date(d.getFullYear(), d.getMonth(), 1),
+      scores: [],
+    };
+    bucket.scores.push(r.score);
+    byMonth.set(key, bucket);
+  }
+  return Array.from(byMonth.values())
+    .sort((a, b) => a.date.getTime() - b.date.getTime())
+    .slice(-6)
+    .map((b) => ({
+      label: MONTH_SHORT[b.date.getMonth()] ?? "",
+      value: Math.round(avg(b.scores) * 100) / 100,
+    }));
+}
+
+/** Counts per month for the trailing 12 months, with the peak flagged. */
+function buildCadence(reviews: RawReview[], now: Date) {
+  // Build the 12-month window ending at `now`'s month, oldest → newest.
+  const months: { date: Date; label: string; value: number }[] = [];
+  for (let i = 11; i >= 0; i--) {
+    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
+    months.push({
+      date: d,
+      label: MONTH_LETTERS[d.getMonth()] ?? "",
+      value: 0,
+    });
+  }
+  const indexByKey = new Map<string, number>();
+  months.forEach((m, i) => {
+    indexByKey.set(`${m.date.getFullYear()}-${m.date.getMonth()}`, i);
+  });
+  for (const r of reviews) {
+    const d = new Date(r.createdAt);
+    if (Number.isNaN(d.getTime())) continue;
+    const idx = indexByKey.get(`${d.getFullYear()}-${d.getMonth()}`);
+    if (idx !== undefined) months[idx].value += 1;
+  }
+
+  let peakIdx = -1;
+  let peakValue = 0;
+  months.forEach((m, i) => {
+    if (m.value > peakValue) {
+      peakValue = m.value;
+      peakIdx = i;
+    }
+  });
+
+  const cadence = months.map((m, i) => ({
+    label: m.label,
+    value: m.value,
+    ...(i === peakIdx && peakValue > 0 ? { peak: true } : {}),
+  }));
+
+  let caption = "Last 12 months";
+  if (peakIdx >= 0 && peakValue > 0) {
+    const peakMonth = MONTH_SHORT[months[peakIdx].date.getMonth()] ?? "";
+    caption = `Last 12 months · peak in ${peakMonth} (${peakValue})`;
+  }
+  return {
+    cadence,
+    caption,
+    peakMonthShort: MONTH_SHORT[months[peakIdx]?.date.getMonth() ?? 0] ?? "",
+    peakValue,
+  };
+}
+
+/** Top regions by count, falling back to country when region is absent. */
+function buildOrigin(reviews: RawReview[], limit = 3) {
+  const counts = new Map<string, number>();
+  for (const r of reviews) {
+    const name = r.region ?? formatEnum(r.country ?? undefined) ?? undefined;
+    if (!name) continue;
+    counts.set(name, (counts.get(name) ?? 0) + 1);
+  }
+  const origin = Array.from(counts.entries())
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, limit)
+    .map(([name, count]) => ({ name, count }));
+
+  const distinctRegions = new Set<string>();
+  const distinctCountries = new Set<string>();
+  for (const r of reviews) {
+    if (r.region) distinctRegions.add(r.region);
+    const c = formatEnum(r.country ?? undefined);
+    if (c) distinctCountries.add(c);
+  }
+  const regionCount = distinctRegions.size || counts.size;
+  const captionParts = [plural(regionCount, "region")];
+  if (distinctCountries.size > 0) {
+    captionParts.push(plural(distinctCountries.size, "country"));
+  }
+  return { origin, caption: captionParts.join(" · ") };
+}
+
+/** Derive up to 3 simple data-driven insights; falls back to fewer when sparse. */
+function buildInsights(
+  reviews: RawReview[],
+  styles: StyleRow[],
+  cadence: { peakMonthShort: string; peakValue: number },
+): Insight[] {
+  const insights: Insight[] = [];
+  const overallAvg = avg(reviews.map((r) => r.score));
+
+  // 1. Top style vs overall average.
+  if (styles.length > 0) {
+    const top = styles[0];
+    const topScores = reviews
+      .filter((r) => formatEnum(r.style ?? undefined) === top.name)
+      .map((r) => r.score);
+    if (topScores.length > 0) {
+      const delta = avg(topScores) - overallAvg;
+      if (Math.abs(delta) >= 0.1) {
+        insights.push({
+          icon: "trophy",
+          title: `${top.name} stands out`,
+          text: `You rate ${top.name} ${delta >= 0 ? "+" : ""}${(
+            Math.round(delta * 10) / 10
+          ).toFixed(1)}★ vs your overall average.`,
+        });
+      } else {
+        insights.push({
+          icon: "trophy",
+          title: `${top.name} leads`,
+          text: `${top.name} is your most-logged style (${top.count}).`,
+        });
+      }
+    }
+  }
+
+  // 2. Peak month.
+  if (cadence.peakValue > 1) {
+    insights.push({
+      icon: "bars",
+      title: `${cadence.peakMonthShort} was your peak`,
+      text: `${cadence.peakValue} logged — your busiest month this year.`,
+    });
+  }
+
+  // 3. Variety of styles.
+  const distinctStyles = new Set(
+    reviews.map((r) => formatEnum(r.style ?? undefined)).filter(Boolean),
+  ).size;
+  if (distinctStyles > 0) {
+    insights.push({
+      icon: "search",
+      title: "A varied palate",
+      text: `You've explored ${plural(distinctStyles, "different style")} so far.`,
+    });
+  }
+
+  return insights;
+}
+
+/**
+ * Build the full live dataset for a (type, period). `rawReviews` is the member's
+ * complete review history for that type (the aggregator handles period bucketing
+ * internally).
+ *
+ * Phase 3 fills `flavorAxes` / `archetype`; here they are neutral defaults.
+ */
+export function buildTasteProfile(
+  type: ItemTypeValue,
+  period: Period,
+  rawReviews: RawReview[],
+  now: Date = new Date(),
+): TasteProfileData {
+  const inPeriod = filterByPeriod(rawReviews, period, now);
+
+  if (inPeriod.length === 0) {
+    return emptyData(type, period);
+  }
+
+  const distinctProducers = new Set(
+    inPeriod.map((r) => r.producer).filter((p): p is string => Boolean(p)),
+  ).size;
+  const distinctStyles = new Set(
+    inPeriod.map((r) => formatEnum(r.style ?? undefined)).filter(Boolean),
+  ).size;
+  const overallAvg = avg(inPeriod.map((r) => r.score));
+
+  const styles = buildStyles(inPeriod, type);
+  const topRated = buildTopRated(inPeriod);
+  const scoreTrend = buildScoreTrend(inPeriod, period);
+  const cadenceResult = buildCadence(inPeriod, now);
+  const originResult = buildOrigin(inPeriod);
+  const insights = buildInsights(inPeriod, styles, cadenceResult);
+
+  const scoreNow = round2(overallAvg);
+  let scoreDelta = "";
+  if (scoreTrend.length >= 2) {
+    const first = scoreTrend[0];
+    const last = scoreTrend[scoreTrend.length - 1];
+    const delta = last.value - first.value;
+    const sign = delta >= 0 ? "+" : "";
+    scoreDelta = `${sign}${round2(delta)} since ${first.label}`;
+  }
+
+  return {
+    archetype: { title: "", description: "" },
+    statTiles: [
+      { value: String(inPeriod.length), label: LOGGED_LABEL[type] },
+      { value: String(distinctProducers), label: PRODUCER_LABEL[type] },
+      { value: String(distinctStyles), label: "Styles" },
+      { value: scoreNow, label: "Avg score" },
+    ],
+    insights,
+    flavorAxes: [],
+    styles,
+    topRated,
+    scoreNow,
+    scoreDelta,
+    scoreTrend,
+    cadence: cadenceResult.cadence,
+    cadenceCaption: cadenceResult.caption,
+    origin: originResult.origin,
+    originCaption: originResult.caption,
+  };
+}
+
+/** Build the unlock state for a type from the per-type logged counts. */
+export function buildUnlockInfo(
+  type: ItemTypeValue,
+  countsByType: Partial<Record<ItemTypeValue, number>>,
+  goal = 15,
+): UnlockInfo {
+  return {
+    type,
+    logged: countsByType[type] ?? 0,
+    goal,
+  };
+}
diff --git a/src/components/taste-profile/data/loadTasteProfile.ts b/src/components/taste-profile/data/loadTasteProfile.ts
new file mode 100644
index 00000000..7fcbe61f
--- /dev/null
+++ b/src/components/taste-profile/data/loadTasteProfile.ts
@@ -0,0 +1,152 @@
+/**
+ * Server-side loader for the Taste Profile dashboard.
+ *
+ * Runs the active type's review query plus the per-type logged-count query with
+ * the member's session (so Hasura permissions apply), folds the rows into the
+ * typed {@link TasteProfileData} contract, and computes the heuristic flavor
+ * fingerprint — all on the server. The client shell receives finished data and
+ * only owns the interactive toggles. AI flavor is fetched client-side on demand
+ * via the `generateAiFlavor` server action.
+ */
+
+import type { ItemTypeValue } from "@cellar-assistant/shared";
+import { serverQuery } from "@/lib/urql/server";
+import { computeHeuristicFlavor } from "../flavor/heuristic";
+import type { FlavorResult, Period, TasteProfileData } from "../types";
+import { buildTasteProfile, type RawReview } from "./buildTasteProfile";
+import { loggedCountsQuery, REVIEW_QUERIES } from "./queries";
+
+type ItemRow = {
+  name: string;
+  style?: string | null;
+  variety?: string | null;
+  type?: string | null;
+  category?: string | null;
+  roast_level?: string | null;
+  region?: string | null;
+  country?: string | null;
+  brands?: Array<{ brand?: { name?: string | null } | null }> | null;
+};
+
+type ReviewRow = {
+  score: number;
+  created_at: string;
+  beer?: ItemRow | null;
+  wine?: ItemRow | null;
+  spirit?: ItemRow | null;
+  coffee?: ItemRow | null;
+  sake?: ItemRow | null;
+  tea?: ItemRow | null;
+};
+
+type CountRow = {
+  beer_id?: string | null;
+  wine_id?: string | null;
+  spirit_id?: string | null;
+  coffee_id?: string | null;
+  sake_id?: string | null;
+  tea_id?: string | null;
+};
+
+/** The style/category field that the dashboard treats as "style" per type. */
+function pickStyle(type: ItemTypeValue, item: ItemRow): string | null {
+  switch (type) {
+    case "BEER":
+      return item.style ?? null;
+    case "WINE":
+      return item.variety ?? item.style ?? null;
+    case "SPIRIT":
+      return item.type ?? null;
+    case "COFFEE":
+      return item.roast_level ?? null;
+    case "SAKE":
+    case "TEA":
+      return item.category ?? null;
+    default:
+      return null;
+  }
+}
+
+function normalizeRow(type: ItemTypeValue, row: ReviewRow): RawReview | null {
+  const item =
+    row.beer ?? row.wine ?? row.spirit ?? row.coffee ?? row.sake ?? row.tea;
+  if (!item) return null;
+  return {
+    score: row.score,
+    createdAt: row.created_at,
+    name: item.name,
+    style: pickStyle(type, item),
+    producer: item.brands?.[0]?.brand?.name ?? null,
+    region: item.region ?? null,
+    country: item.country ?? null,
+  };
+}
+
+function countByType(rows: CountRow[]): Partial<Record<ItemTypeValue, number>> {
+  const counts: Partial<Record<ItemTypeValue, number>> = {
+    BEER: 0,
+    WINE: 0,
+    SPIRIT: 0,
+    COFFEE: 0,
+    SAKE: 0,
+    TEA: 0,
+  };
+  for (const r of rows) {
+    if (r.beer_id) counts.BEER = (counts.BEER ?? 0) + 1;
+    else if (r.wine_id) counts.WINE = (counts.WINE ?? 0) + 1;
+    else if (r.spirit_id) counts.SPIRIT = (counts.SPIRIT ?? 0) + 1;
+    else if (r.coffee_id) counts.COFFEE = (counts.COFFEE ?? 0) + 1;
+    else if (r.sake_id) counts.SAKE = (counts.SAKE ?? 0) + 1;
+    else if (r.tea_id) counts.TEA = (counts.TEA ?? 0) + 1;
+  }
+  return counts;
+}
+
+const EMPTY_FLAVOR: FlavorResult = {
+  axes: [],
+  archetype: { title: "", description: "" },
+};
+
+export type TasteProfileLoad = {
+  data: TasteProfileData | null;
+  heuristicFlavor: FlavorResult;
+  countsByType: Partial<Record<ItemTypeValue, number>>;
+};
+
+export async function loadTasteProfile(
+  userId: string,
+  type: ItemTypeValue,
+  period: Period,
+): Promise<TasteProfileLoad> {
+  const [reviewResult, countsResult] = await Promise.allSettled([
+    serverQuery(REVIEW_QUERIES[type], { userId }),
+    serverQuery(loggedCountsQuery, { userId }),
+  ]);
+
+  let data: TasteProfileData | null = null;
+  if (reviewResult.status === "fulfilled") {
+    const rows = ((reviewResult.value as { item_reviews?: ReviewRow[] })
+      .item_reviews ?? []) as ReviewRow[];
+    const reviews = rows
+      .map((row) => normalizeRow(type, row))
+      .filter((r): r is RawReview => r !== null);
+    data = buildTasteProfile(type, period, reviews);
+  } else {
+    console.error("Taste profile review query failed:", reviewResult.reason);
+  }
+
+  let countsByType: Partial<Record<ItemTypeValue, number>> = {};
+  if (countsResult.status === "fulfilled") {
+    const rows = ((countsResult.value as { item_reviews?: CountRow[] })
+      .item_reviews ?? []) as CountRow[];
+    countsByType = countByType(rows);
+  } else {
+    console.error("Taste profile counts query failed:", countsResult.reason);
+  }
+
+  const heuristicFlavor = data
+    ? computeHeuristicFlavor(data.styles)
+    : EMPTY_FLAVOR;
+
+  return { data, heuristicFlavor, countsByType };
+}
diff --git a/src/components/taste-profile/data/queries.ts b/src/components/taste-profile/data/queries.ts
new file mode 100644
index 00000000..2ef4c085
--- /dev/null
+++ b/src/components/taste-profile/data/queries.ts
@@ -0,0 +1,165 @@
+/**
+ * gql.tada queries that back the live Taste Profile dashboard (Phase 2).
+ *
+ * Each item type lives in its own table (beers, wines, …) joined to the member's
+ * history via `item_reviews`. Because the "style"/region fields differ per type,
+ * there is one review query per type — they all share the same envelope shape so
+ * the aggregator can treat them uniformly.
+ */
+
+import { graphql, type ItemTypeValue } from "@cellar-assistant/shared";
+
+/**
+ * Producer is the (primary) brand name. Ordering by `is_primary` desc puts the
+ * primary brand first; we read the first entry in the aggregator.
+ */
+const reviewBrandsSelection = `
+  brands(order_by: { is_primary: desc }, limit: 1) {
+    brand {
+      name
+    }
+  }
+`;
+
+export const beerReviewsQuery = graphql(`
+  query TasteProfileBeerReviews($userId: uuid!) {
+    item_reviews(
+      where: { user_id: { _eq: $userId }, beer_id: { _is_null: false } }
+      order_by: { created_at: asc }
+    ) {
+      score
+      created_at
+      beer {
+        name
+        style
+        country
+        ${reviewBrandsSelection}
+      }
+    }
+  }
+`);
+
+export const wineReviewsQuery = graphql(`
+  query TasteProfileWineReviews($userId: uuid!) {
+    item_reviews(
+      where: { user_id: { _eq: $userId }, wine_id: { _is_null: false } }
+      order_by: { created_at: asc }
+    ) {
+      score
+      created_at
+      wine {
+        name
+        variety
+        style
+        region
+        country
+        ${reviewBrandsSelection}
+      }
+    }
+  }
+`);
+
+export const spiritReviewsQuery = graphql(`
+  query TasteProfileSpiritReviews($userId: uuid!) {
+    item_reviews(
+      where: { user_id: { _eq: $userId }, spirit_id: { _is_null: false } }
+      order_by: { created_at: asc }
+    ) {
+      score
+      created_at
+      spirit {
+        name
+        type
+        country
+        ${reviewBrandsSelection}
+      }
+    }
+  }
+`);
+
+export const coffeeReviewsQuery = graphql(`
+  query TasteProfileCoffeeReviews($userId: uuid!) {
+    item_reviews(
+      where: { user_id: { _eq: $userId }, coffee_id: { _is_null: false } }
+      order_by: { created_at: asc }
+    ) {
+      score
+      created_at
+      coffee {
+        name
+        roast_level
+        country
+        ${reviewBrandsSelection}
+      }
+    }
+  }
+`);
+
+export const sakeReviewsQuery = graphql(`
+  query TasteProfileSakeReviews($userId: uuid!) {
+    item_reviews(
+      where: { user_id: { _eq: $userId }, sake_id: { _is_null: false } }
+      order_by: { created_at: asc }
+    ) {
+      score
+      created_at
+      sake {
+        name
+        category
+        region
+        country
+        ${reviewBrandsSelection}
+      }
+    }
+  }
+`);
+
+export const teaReviewsQuery = graphql(`
+  query TasteProfileTeaReviews($userId: uuid!) {
+    item_reviews(
+      where: { user_id: { _eq: $userId }, tea_id: { _is_null: false } }
+      order_by: { created_at: asc }
+    ) {
+      score
+      created_at
+      tea {
+        name
+        category
+        region
+        country
+        ${reviewBrandsSelection}
+      }
+    }
+  }
+`);
+
+/** The per-type review query used by the live dashboard, keyed by item type. */
+export const REVIEW_QUERIES = {
+  BEER: beerReviewsQuery,
+  WINE: wineReviewsQuery,
+  SPIRIT: spiritReviewsQuery,
+  COFFEE: coffeeReviewsQuery,
+  SAKE: sakeReviewsQuery,
+  TEA: teaReviewsQuery,
+} satisfies Record<ItemTypeValue, unknown>;
+
+/**
+ * Returns the member's review rows (type-id columns only) so the dashboard can
+ * count reviewed items per type and drive the unlock state.
+ *
+ * NOTE: the `user` role is not granted root-level `item_reviews_aggregate`
+ * permission, so we select the rows and count client-side instead of using an
+ * aggregate query (which fails validation for that role).
+ */
+export const loggedCountsQuery = graphql(`
+  query TasteProfileLoggedCounts($userId: uuid!) {
+    item_reviews(where: { user_id: { _eq: $userId } }) {
+      beer_id
+      wine_id
+      spirit_id
+      coffee_id
+      sake_id
+      tea_id
+    }
+  }
+`);
diff --git a/src/components/taste-profile/flavor/heuristic.ts b/src/components/taste-profile/flavor/heuristic.ts
new file mode 100644
index 00000000..de9a1442
--- /dev/null
+++ b/src/components/taste-profile/flavor/heuristic.ts
@@ -0,0 +1,150 @@
+/**
+ * Heuristic flavor fingerprint + archetype (A/B option A).
+ *
+ * Maps each beer style to a 6-axis flavor vector, then takes a count-weighted
+ * average across the member's logged styles. No schema changes, no AI latency —
+ * an approximate but instant fingerprint. Compared against the AI source in the
+ * UI via the flavor-source toggle.
+ */
+
+import type { Archetype, FlavorAxis, FlavorResult, StyleRow } from "../types";
+
+export const FLAVOR_AXES = [
+  "Hoppy",
+  "Fruity",
+  "Sour",
+  "Roasty",
+  "Malty",
+  "Bitter",
+] as const;
+
+type Axis = (typeof FLAVOR_AXES)[number];
+type Vector = Record<Axis, number>;
+
+const vec = (
+  hoppy: number,
+  fruity: number,
+  sour: number,
+  roasty: number,
+  malty: number,
+  bitter: number,
+): Vector => ({
+  Hoppy: hoppy,
+  Fruity: fruity,
+  Sour: sour,
+  Roasty: roasty,
+  Malty: malty,
+  Bitter: bitter,
+});
+
+/**
+ * Keyword → flavor vector. Matched against a normalized style string, most
+ * specific keywords first (e.g. "imperial stout" before "stout").
+ */
+const STYLE_RULES: { match: string[]; v: Vector }[] = [
+  { match: ["hazy", "neipa", "new england"], v: vec(80, 80, 15, 5, 30, 45) },
+  { match: ["west coast"], v: vec(90, 45, 5, 10, 30, 90) },
+  {
+    match: ["double ipa", "imperial ipa", "dipa", "triple ipa"],
+    v: vec(95, 60, 10, 10, 45, 85),
+  },
+  { match: ["session ipa"], v: vec(75, 55, 10, 8, 25, 65) },
+  { match: ["ipa", "india pale"], v: vec(85, 55, 10, 10, 35, 80) },
+  { match: ["pale ale", "apa"], v: vec(60, 45, 10, 15, 40, 55) },
+  {
+    match: ["imperial stout", "barrel-aged", "barrel aged"],
+    v: vec(20, 25, 8, 92, 78, 55),
+  },
+  { match: ["stout"], v: vec(20, 22, 8, 88, 72, 52) },
+  { match: ["porter"], v: vec(25, 20, 8, 70, 70, 45) },
+  {
+    match: ["pilsner", "pils", "lager", "helles", "kolsch", "kölsch"],
+    v: vec(35, 15, 8, 10, 45, 40),
+  },
+  { match: ["barleywine", "barley wine"], v: vec(45, 50, 10, 40, 90, 55) },
+  { match: ["saison", "farmhouse"], v: vec(35, 60, 35, 10, 35, 35) },
+  {
+    match: ["gose", "berliner", "lambic", "sour", "wild"],
+    v: vec(15, 55, 90, 8, 25, 20),
+  },
+  {
+    match: ["hefeweizen", "witbier", "wheat", "weisse"],
+    v: vec(25, 55, 25, 8, 45, 25),
+  },
+  {
+    match: ["tripel", "dubbel", "quad", "belgian", "abbey"],
+    v: vec(30, 65, 20, 25, 70, 35),
+  },
+  {
+    match: ["amber", "red ale", "brown ale", "altbier", "bock"],
+    v: vec(35, 30, 8, 45, 70, 40),
+  },
+  { match: ["fruit", "milkshake", "pastry"], v: vec(35, 80, 20, 25, 45, 30) },
+];
+
+const DEFAULT_VECTOR = vec(40, 40, 20, 30, 50, 45);
+
+/** Community baseline used as the "compare to community" reference line. */
+export const COMMUNITY_BASELINE: Vector = vec(58, 50, 41, 55, 64, 52);
+
+const vectorForStyle = (name: string): Vector => {
+  const norm = name.toLowerCase();
+  for (const rule of STYLE_RULES) {
+    if (rule.match.some((m) => norm.includes(m))) return rule.v;
+  }
+  return DEFAULT_VECTOR;
+};
+
+const ARCHETYPE_BY_AXIS: Record<Axis, { title: string; trait: string }> = {
+  Hoppy: { title: "The Hop-Forward Wanderer", trait: "hoppy and adventurous" },
+  Fruity: {
+    title: "The Fruit-Forward Explorer",
+    trait: "bright and fruit-driven",
+  },
+  Sour: { title: "The Sour Seeker", trait: "tart and funk-loving" },
+  Roasty: {
+    title: "The Dark & Roasty Devotee",
+    trait: "deep and roast-forward",
+  },
+  Malty: { title: "The Malt Maven", trait: "rich and malt-driven" },
+  Bitter: { title: "The Bitter Enthusiast", trait: "bracingly bitter" },
+};
+
+const buildArchetype = (axes: FlavorAxis[], styles: StyleRow[]): Archetype => {
+  const top = [...axes].sort((a, b) => b.you - a.you)[0];
+  const dominant = (top?.name as Axis) ?? "Hoppy";
+  const { title, trait } =
+    ARCHETYPE_BY_AXIS[dominant] ?? ARCHETYPE_BY_AXIS.Hoppy;
+
+  const ranked = [...styles].sort((a, b) => b.count - a.count);
+  const leadStyle = ranked[0]?.name ?? "your favorites";
+  const variety = styles.length;
+
+  const description =
+    variety >= 6
+      ? `You lean ${trait} — ${leadStyle} leads the cellar, but your pours range across ${variety} styles.`
+      : `You lean ${trait} — ${leadStyle} leads the cellar, with a focused set of ${variety} styles.`;
+
+  return { title, description };
+};
+
+/** Compute the heuristic flavor fingerprint + archetype from style counts. */
+export function computeHeuristicFlavor(styles: StyleRow[]): FlavorResult {
+  const totals: Vector = vec(0, 0, 0, 0, 0, 0);
+  let weight = 0;
+
+  for (const s of styles) {
+    const v = vectorForStyle(s.name);
+    const w = Math.max(0, s.count);
+    weight += w;
+    for (const axis of FLAVOR_AXES) totals[axis] += v[axis] * w;
+  }
+
+  const axes: FlavorAxis[] = FLAVOR_AXES.map((axis) => ({
+    name: axis,
+    you: weight > 0 ? Math.round(totals[axis] / weight) : DEFAULT_VECTOR[axis],
+    avg: COMMUNITY_BASELINE[axis],
+  }));
+
+  return { axes, archetype: buildArchetype(axes, styles) };
+}
diff --git a/src/components/taste-profile/flavor/useFlavorResult.ts b/src/components/taste-profile/flavor/useFlavorResult.ts
