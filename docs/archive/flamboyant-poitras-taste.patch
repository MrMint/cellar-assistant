diff --git a/src/components/taste-profile/charts/LineChart.tsx b/src/components/taste-profile/charts/LineChart.tsx
new file mode 100644
index 00000000..5ebafe59
--- /dev/null
+++ b/src/components/taste-profile/charts/LineChart.tsx
@@ -0,0 +1,109 @@
+"use client";
+
+import { useId } from "react";
+import { tp } from "../tokens";
+import type { ScorePoint } from "../types";
+
+type LineChartProps = {
+  points: ScorePoint[];
+  /** Fixed y-domain (default 3.4–4.6 per the spec). */
+  min?: number;
+  max?: number;
+  /** Faint horizontal gridlines. */
+  gridlines?: number[];
+};
+
+/**
+ * Average-score-over-time line chart. Amber line + gradient area fill, fixed
+ * y-domain, last point emphasized. Ported from the design prototype.
+ */
+export const LineChart = ({
+  points,
+  min = 3.4,
+  max = 4.6,
+  gridlines = [4.0, 4.4],
+}: LineChartProps) => {
+  const gradientId = useId();
+  const w = 520;
+  const h = 150;
+  const padB = 24;
+  const padT = 12;
+  const ih = h - padB - padT;
+
+  if (points.length === 0) return null;
+
+  const X = (i: number) =>
+    points.length === 1 ? w / 2 : 6 + (i / (points.length - 1)) * (w - 12);
+  const Y = (v: number) => padT + ih - ((v - min) / (max - min)) * ih;
+
+  const line = points
+    .map((p, i) => `${X(i).toFixed(1)},${Y(p.value).toFixed(1)}`)
+    .join(" ");
+  const baseY = (padT + ih).toFixed(1);
+  const area = `6,${baseY} ${line} ${(w - 6).toFixed(1)},${baseY}`;
+
+  return (
+    <svg
+      viewBox={`0 0 ${w} ${h}`}
+      width="100%"
+      height="100%"
+      preserveAspectRatio="xMidYMid meet"
+      role="img"
+      aria-label="Average score over time"
+      style={{ display: "block" }}
+    >
+      <defs>
+        <linearGradient id={gradientId} x1={0} y1={0} x2={0} y2={1}>
+          <stop offset="0%" stopColor="rgba(218,165,32,0.34)" />
+          <stop offset="100%" stopColor="rgba(218,165,32,0)" />
+        </linearGradient>
+      </defs>
+      {gridlines.map((gv) => (
+        <line
+          key={`grid-${gv}`}
+          x1={6}
+          x2={w - 6}
+          y1={Y(gv)}
+          y2={Y(gv)}
+          stroke="rgba(255,255,255,0.06)"
+          strokeWidth={1}
+        />
+      ))}
+      <polygon points={area} fill={`url(#${gradientId})`} />
+      <polyline
+        points={line}
+        fill="none"
+        stroke={tp.color.amber}
+        strokeWidth={2.5}
+        strokeLinejoin="round"
+        strokeLinecap="round"
+      />
+      {points.map((p, i) => {
+        const last = i === points.length - 1;
+        return (
+          <circle
+            key={`pt-${p.label}`}
+            cx={X(i)}
+            cy={Y(p.value)}
+            r={last ? 5 : 3}
+            fill={last ? tp.color.amber : "#0C0B10"}
+            stroke={tp.color.amber}
+            strokeWidth={2}
+          />
+        );
+      })}
+      {points.map((p, i) => (
+        <text
+          key={`xlabel-${p.label}`}
+          x={X(i)}
+          y={h - 6}
+          textAnchor="middle"
+          fill={tp.color.textTertiary}
+          style={{ fontSize: 11 }}
+        >
+          {p.label}
+        </text>
+      ))}
+    </svg>
+  );
+};
diff --git a/src/components/taste-profile/charts/RadarChart.tsx b/src/components/taste-profile/charts/RadarChart.tsx
new file mode 100644
index 00000000..8c1161c2
--- /dev/null
+++ b/src/components/taste-profile/charts/RadarChart.tsx
@@ -0,0 +1,129 @@
+"use client";
+
+import { tp } from "../tokens";
+import type { FlavorAxis } from "../types";
+
+type RadarChartProps = {
+  axes: FlavorAxis[];
+  size?: number;
+  showCompare?: boolean;
+};
+
+/**
+ * Radar / spider chart for the flavor fingerprint. Ported from the design
+ * prototype: N axes evenly around the circle, 4 concentric grid rings, a filled
+ * "you" polygon and an optional dashed "community" polygon.
+ */
+export const RadarChart = ({
+  axes,
+  size = 280,
+  showCompare = true,
+}: RadarChartProps) => {
+  const cx = size / 2;
+  const cy = size / 2;
+  const R = size * 0.34;
+  const n = axes.length;
+
+  const ang = (i: number) => -Math.PI / 2 + (i * 2 * Math.PI) / n;
+  const pt = (i: number, r: number): [number, number] => [
+    +(cx + Math.cos(ang(i)) * r).toFixed(1),
+    +(cy + Math.sin(ang(i)) * r).toFixed(1),
+  ];
+  const ring = (f: number) =>
+    axes.map((_, i) => pt(i, R * f).join(",")).join(" ");
+  const poly = (key: "you" | "avg") =>
+    axes.map((a, i) => pt(i, R * (a[key] / 100)).join(",")).join(" ");
+
+  const labelSize = size > 300 ? 14 : size > 230 ? 13 : 11;
+  const dotR = size > 230 ? 3.4 : 2.6;
+  const labelOffset = size > 230 ? 20 : 15;
+
+  return (
+    <svg
+      viewBox={`0 0 ${size} ${size}`}
+      width="100%"
+      height="100%"
+      role="img"
+      aria-label="Flavor fingerprint radar chart"
+      style={{ display: "block", overflow: "visible", maxHeight: size }}
+    >
+      {/* grid rings */}
+      {[0.25, 0.5, 0.75, 1].map((f, ri) => (
+        <polygon
+          key={`ring-${f}`}
+          points={ring(f)}
+          fill={ri === 3 ? "rgba(255,255,255,0.02)" : "none"}
+          stroke="rgba(255,255,255,0.09)"
+          strokeWidth={1}
+        />
+      ))}
+      {/* spokes */}
+      {axes.map((axis, i) => {
+        const [x, y] = pt(i, R);
+        return (
+          <line
+            key={`spoke-${axis.name}`}
+            x1={cx}
+            y1={cy}
+            x2={x}
+            y2={y}
+            stroke="rgba(255,255,255,0.08)"
+            strokeWidth={1}
+          />
+        );
+      })}
+      {/* community polygon */}
+      {showCompare && (
+        <polygon
+          points={poly("avg")}
+          fill="none"
+          stroke={tp.color.primary500}
+          strokeWidth={1.5}
+          strokeDasharray="4 3"
+          opacity={0.85}
+          strokeLinejoin="round"
+        />
+      )}
+      {/* you polygon */}
+      <polygon
+        points={poly("you")}
+        fill="rgba(218,165,32,0.22)"
+        stroke={tp.color.amber}
+        strokeWidth={2}
+        strokeLinejoin="round"
+      />
+      {/* you vertices */}
+      {axes.map((a, i) => {
+        const [x, y] = pt(i, R * (a.you / 100));
+        return (
+          <circle
+            key={`vtx-${a.name}`}
+            cx={x}
+            cy={y}
+            r={dotR}
+            fill={tp.color.amber}
+          />
+        );
+      })}
+      {/* axis labels */}
+      {axes.map((a, i) => {
+        const [x, y] = pt(i, R + labelOffset);
+        const c = Math.cos(ang(i));
+        const anchor = c > 0.3 ? "start" : c < -0.3 ? "end" : "middle";
+        return (
+          <text
+            key={`axis-${a.name}`}
+            x={x}
+            y={y}
+            textAnchor={anchor}
+            dominantBaseline="middle"
+            fill={tp.color.textSecondary}
+            style={{ fontSize: labelSize, fontWeight: 600 }}
+          >
+            {a.name}
+          </text>
+        );
+      })}
+    </svg>
+  );
+};
