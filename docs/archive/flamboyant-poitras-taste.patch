+"use client";
+
+import { Box } from "@mui/joy";
+import { MdCheck } from "react-icons/md";
+import { RadarChart } from "../charts/RadarChart";
+import { tp } from "../tokens";
+import type { FlavorAxis, FlavorSource } from "../types";
+import { ModuleCard } from "./ModuleCard";
+
+type FlavorFingerprintProps = {
+  axes: FlavorAxis[];
+  compare: boolean;
+  onToggleCompare: () => void;
+  /** A/B: which source produced these axes. */
+  source: FlavorSource;
+  onToggleSource: () => void;
+  radarSize?: number;
+};
+
+const deltaLabel = (you: number, avg: number) => {
+  const d = you - avg;
+  return d >= 0 ? `+${d}` : `${d}`;
+};
+
+const deltaColor = (you: number, avg: number) => {
+  const d = you - avg;
+  if (d >= 8) return tp.color.success300;
+  if (d <= -8) return tp.color.textTertiary;
+  return tp.color.textSecondary;
+};
+
+/** Flavor fingerprint: radar + per-axis legend, with compare + source toggles. */
+export const FlavorFingerprint = ({
+  axes,
+  compare,
+  onToggleCompare,
+  source,
+  onToggleSource,
+  radarSize = 280,
+}: FlavorFingerprintProps) => {
+  const compareToggle = (
+    <Box sx={{ display: "flex", alignItems: "center", gap: "8px" }}>
+      <SourceToggle source={source} onToggle={onToggleSource} />
+      <Box
+        onClick={onToggleCompare}
+        role="switch"
+        aria-checked={compare}
+        tabIndex={0}
+        onKeyDown={(e) => {
+          if (e.key === "Enter" || e.key === " ") {
+            e.preventDefault();
+            onToggleCompare();
+          }
+        }}
+        sx={{
+          display: "inline-flex",
+          alignItems: "center",
+          gap: "8px",
+          cursor: "pointer",
+          padding: "5px 11px",
+          borderRadius: tp.radius.pill,
+          background: compare ? "rgba(112,163,169,0.12)" : "transparent",
+          border: `1px solid ${compare ? tp.color.primary500 : tp.color.border}`,
+          fontSize: tp.fontSize.xs,
+          fontWeight: 600,
+          color: compare ? tp.color.primary300 : tp.color.textSecondary,
+          transition: `all ${tp.duration.fast} ${tp.ease.standard}`,
+        }}
+      >
+        <Box
+          sx={{
+            width: "15px",
+            height: "15px",
+            borderRadius: "4px",
+            border: `1.5px solid ${compare ? tp.color.primary500 : tp.color.border}`,
+            background: compare ? tp.color.primary500 : "transparent",
+            display: "inline-flex",
+            alignItems: "center",
+            justifyContent: "center",
+            fontSize: "11px",
+            color: "#111015",
+          }}
+        >
+          {compare && <MdCheck />}
+        </Box>
+        Compare to community
+      </Box>
+    </Box>
+  );
+
+  return (
+    <ModuleCard title="Flavor fingerprint" action={compareToggle}>
+      <Box
+        sx={{
+          display: "grid",
+          gridTemplateColumns: { xs: "1fr", sm: "1fr 152px" },
+          gap: "14px",
+          alignItems: "center",
+        }}
+      >
+        <Box
+          sx={{
+            height: `${radarSize - 20}px`,
+            padding: "16px 6px 0",
+            overflow: "visible",
+          }}
+        >
+          <RadarChart axes={axes} size={radarSize} showCompare={compare} />
+        </Box>
+        <Box sx={{ display: "flex", flexDirection: "column", gap: "9px" }}>
+          {axes.map((f) => (
+            <Box
+              key={f.name}
+              sx={{
+                display: "flex",
+                alignItems: "center",
+                justifyContent: "space-between",
+                gap: "8px",
+              }}
+            >
+              <Box
+                sx={{ fontSize: tp.fontSize.sm, color: tp.color.textSecondary }}
+              >
+                {f.name}
+              </Box>
+              <Box
+                sx={{
+                  fontSize: tp.fontSize.xs,
+                  fontWeight: 700,
+                  fontVariantNumeric: "tabular-nums",
+                  color: compare
+                    ? deltaColor(f.you, f.avg)
+                    : tp.color.textSecondary,
+                }}
+              >
+                {compare ? deltaLabel(f.you, f.avg) : `${f.you}`}
+              </Box>
+            </Box>
+          ))}
+        </Box>
+      </Box>
+    </ModuleCard>
+  );
+};
+
+/**
+ * A/B switch between the heuristic and AI flavor sources. Lets the team compare
+ * the two approaches side by side (Phase 3 decision).
+ */
+const SourceToggle = ({
+  source,
+  onToggle,
+}: {
+  source: FlavorSource;
+  onToggle: () => void;
+}) => (
+  <Box
+    onClick={onToggle}
+    role="button"
+    tabIndex={0}
+    aria-label={`Flavor source: ${source}. Click to switch.`}
+    onKeyDown={(e) => {
+      if (e.key === "Enter" || e.key === " ") {
+        e.preventDefault();
+        onToggle();
+      }
+    }}
+    title="Switch flavor source (heuristic / AI)"
+    sx={{
+      display: "inline-flex",
+      alignItems: "center",
+      gap: "6px",
+      cursor: "pointer",
+      padding: "5px 10px",
+      borderRadius: tp.radius.pill,
+      background: "rgba(218,165,32,0.10)",
+      border: `1px solid ${tp.color.border}`,
+      fontSize: "11px",
+      fontWeight: 700,
+      letterSpacing: "0.04em",
+      textTransform: "uppercase",
+      color: tp.color.amberLight,
+      transition: `all ${tp.duration.fast} ${tp.ease.standard}`,
+    }}
+  >
+    {source === "ai" ? "AI" : "Heuristic"}
+  </Box>
+);
