+"use client";
+
+import { Box } from "@mui/joy";
+import { BarTrack } from "../charts/BarTrack";
+import { tp } from "../tokens";
+import type { OriginRow } from "../types";
+import { ModuleCard } from "./ModuleCard";
+
+type OriginBreakdownProps = {
+  origin: OriginRow[];
+  caption: string;
+  onOpenAtlas?: () => void;
+};
+
+/** "Where it comes from": top regions + a footer link to the origin atlas. */
+export const OriginBreakdown = ({
+  origin,
+  caption,
+  onOpenAtlas,
+}: OriginBreakdownProps) => {
+  const max = Math.max(1, ...origin.map((g) => g.count));
+
+  return (
+    <ModuleCard
+      title="Where it comes from"
+      fill
+      action={
+        <Box sx={{ fontSize: tp.fontSize.xs, color: tp.color.textTertiary }}>
+          {caption}
+        </Box>
+      }
+    >
+      <Box
+        sx={{ display: "flex", flexDirection: "column", gap: "12px", flex: 1 }}
+      >
+        {origin.map((g) => (
+          <Box
+            key={g.name}
+            sx={{ display: "flex", alignItems: "center", gap: "11px" }}
+          >
+            <Box
+              sx={{
+                width: "96px",
+                flex: "0 0 96px",
+                fontSize: tp.fontSize.sm,
+                color: tp.color.textSecondary,
+                fontWeight: 500,
+              }}
+            >
+              {g.name}
+            </Box>
+            <BarTrack
+              ratio={g.count / max}
+              color={tp.color.amber}
+              height={8}
+              animate={false}
+            />
+            <Box
+              sx={{
+                width: "20px",
+                textAlign: "right",
+                fontSize: tp.fontSize.sm,
+                fontWeight: 700,
+                fontVariantNumeric: "tabular-nums",
+              }}
+            >
+              {g.count}
+            </Box>
+          </Box>
+        ))}
+      </Box>
+      <Box
+        onClick={onOpenAtlas}
+        role="link"
+        tabIndex={0}
+        onKeyDown={(e) => {
+          if (e.key === "Enter") onOpenAtlas?.();
+        }}
+        sx={{
+          display: "flex",
+          alignItems: "center",
+          justifyContent: "space-between",
+          mt: "16px",
+          pt: "14px",
+          borderTop: `1px solid ${tp.color.divider}`,
+          fontSize: tp.fontSize.sm,
+          fontWeight: 600,
+          color: tp.color.primary300,
+          cursor: "pointer",
+        }}
+      >
+        <span>Open your beer atlas</span>
+        <span style={{ fontSize: "15px" }}>→</span>
+      </Box>
+    </ModuleCard>
+  );
+};
