@@ -0,0 +1,180 @@
+"use client";
+
+import type { ItemTypeValue } from "@cellar-assistant/shared";
+import { Box } from "@mui/joy";
+import type { StaticImageData } from "next/image";
+import { usePathname, useRouter } from "next/navigation";
+import { useState, useTransition } from "react";
+import beer1 from "@/images/beer1.png";
+import coffee1 from "@/images/coffee1.png";
+import sake1 from "@/images/sake1.png";
+import spirit1 from "@/images/spirit1.png";
+import tea1 from "@/images/tea1.png";
+import wine1 from "@/images/wine1.png";
+import { formatItemType } from "@/utilities";
+import { useFlavorResult } from "./flavor/useFlavorResult";
+import { UNLOCK_GOAL } from "./mockData";
+import { FlavorFingerprint } from "./modules/FlavorFingerprint";
+import { IdentityBanner } from "./modules/IdentityBanner";
+import { InsightsStrip } from "./modules/InsightsStrip";
+import { OriginBreakdown } from "./modules/OriginBreakdown";
+import { ScoreOverTime } from "./modules/ScoreOverTime";
+import { TastingCadence } from "./modules/TastingCadence";
+import { TopRated } from "./modules/TopRated";
+import { TopStyles } from "./modules/TopStyles";
+import { UnlockState } from "./modules/UnlockState";
+import { TasteProfileHeader } from "./TasteProfileHeader";
+import { tp } from "./tokens";
+import type {
+  FlavorResult,
+  FlavorSource,
+  Period,
+  TasteProfileData,
+} from "./types";
+
+const ILLUSTRATION: Record<ItemTypeValue, StaticImageData> = {
+  BEER: beer1,
+  WINE: wine1,
+  SPIRIT: spirit1,
+  COFFEE: coffee1,
+  SAKE: sake1,
+  TEA: tea1,
+};
+
+/** Two columns that collapse to one on small screens. */
+const row = (cols: string) => ({
+  display: "grid",
+  gridTemplateColumns: { xs: "1fr", md: cols },
+  gap: "20px",
+});
+
+type TasteProfileClientProps = {
+  type: ItemTypeValue;
+  period: Period;
+  data: TasteProfileData | null;
+  heuristicFlavor: FlavorResult;
+  countsByType: Partial<Record<ItemTypeValue, number>>;
+};
+
+export const TasteProfileClient = ({
+  type,
+  period,
+  data,
+  heuristicFlavor,
+  countsByType,
+}: TasteProfileClientProps) => {
+  const router = useRouter();
+  const pathname = usePathname();
+  const [isPending, startTransition] = useTransition();
+  const [compare, setCompare] = useState(true);
+  const [flavorSource, setFlavorSource] = useState<FlavorSource>("heuristic");
+
+  const { flavor } = useFlavorResult(type, flavorSource, data, heuristicFlavor);
+
+  const logged = countsByType[type] ?? 0;
+  const unlocked = logged >= UNLOCK_GOAL && data !== null;
+  const label = formatItemType(type).toLowerCase();
+
+  // type/period live in the URL so views are shareable and re-fetch on the
+  // server; the transition keeps the swap non-blocking.
+  const navigate = (next: { type?: ItemTypeValue; period?: Period }) => {
+    const params = new URLSearchParams({
+      type: (next.type ?? type).toLowerCase(),
+      period: next.period ?? period,
+    });
+    startTransition(() => {
+      router.replace(`${pathname}?${params.toString()}`, { scroll: false });
+    });
+  };
+
+  const body = () => {
+    if (!unlocked || !data) {
+      return (
+        <UnlockState
+          info={{ type, logged, goal: UNLOCK_GOAL }}
+          onAdd={() => router.push(`/search?type=${label}`)}
+        />
+      );
+    }
+
+    return (
+      <Box sx={{ display: "flex", flexDirection: "column", gap: "20px" }}>
+        <IdentityBanner
+          archetype={flavor.archetype}
+          statTiles={data.statTiles}
+          illustration={ILLUSTRATION[type]}
+          illustrationAlt={formatItemType(type)}
+          eyebrow={`Your ${label} taste identity`}
+        />
+
+        {data.insights.length > 0 && <InsightsStrip insights={data.insights} />}
+
+        <Box sx={row("1.05fr 1fr")}>
+          <FlavorFingerprint
+            axes={flavor.axes}
+            compare={compare}
+            onToggleCompare={() => setCompare((c) => !c)}
+            source={flavorSource}
+            onToggleSource={() =>
+              setFlavorSource((s) => (s === "ai" ? "heuristic" : "ai"))
+            }
+          />
+          <TopStyles
+            styles={data.styles}
+            periodNote={period === "year" ? "this year" : "all time"}
+          />
+        </Box>
+
+        <Box sx={row("1.05fr 1fr")}>
+          <TopRated items={data.topRated} />
+          <ScoreOverTime
+            scoreNow={data.scoreNow}
+            scoreDelta={data.scoreDelta}
+            trend={data.scoreTrend}
+          />
+        </Box>
+
+        <Box sx={row("1.3fr 1fr")}>
+          <TastingCadence months={data.cadence} caption={data.cadenceCaption} />
+          <OriginBreakdown
+            origin={data.origin}
+            caption={data.originCaption}
+            onOpenAtlas={() => router.push("/map")}
+          />
+        </Box>
+      </Box>
+    );
+  };
+
+  return (
+    <Box
+      sx={{
+        height: "100%",
+        overflowY: "auto",
+        overflowX: "hidden",
+        background: tp.color.bgBody,
+        color: tp.color.textPrimary,
+      }}
+    >
+      <TasteProfileHeader
+        type={type}
+        onTypeChange={(t) => navigate({ type: t })}
+        period={period}
+        onPeriodChange={(p) => navigate({ period: p })}
+      />
+
+      <Box
+        sx={{
+          maxWidth: "1180px",
+          margin: "0 auto",
+          padding: "26px 30px 64px",
+          opacity: isPending ? 0.55 : 1,
+          transition: `opacity ${tp.duration.base} ${tp.ease.standard}`,
+          pointerEvents: isPending ? "none" : "auto",
+        }}
+      >
+        {body()}
+      </Box>
+    </Box>
+  );
+};
