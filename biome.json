{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "**/*.css",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/graphql-env.d.ts",
      "!packages/db/migrations",
      "!packages/db/src/schema/tables.ts",
      "!packages/db/src/schema/relations.ts",
      "!**/wisconsin-places.json",
      "!CHANGELOG.md",
      "!nhost",
      "!packages/e2e/artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["services/client/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["services/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "framer-motion": "Use motion/react and the tokens in @/lib/motion.",
                  "react-icons": "Use the Lucide vocabulary in @/components/app/icons.",
                  "react-simple-star-rating": "Use RatingInput / RatingDisplay from @/components/app/RatingInput."
                },
                "patterns": [
                  {
                    "group": ["@mui/**", "@emotion/**"],
                    "message": "MUI and Emotion were removed (D20): use shadcn/ui (src/components/ui) and the app primitives (src/components/app)."
                  },
                  {
                    "group": ["react-icons/**"],
                    "message": "Use the Lucide vocabulary in @/components/app/icons."
                  },
                  {
                    "group": ["framer-motion/**"],
                    "message": "Use motion/react and the tokens in @/lib/motion."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          },
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    }
  ]
}
