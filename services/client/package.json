{
  "name": "@cellar-assistant/client",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/copy-maplibre-worker.mjs && bun run --bun next build",
    "build:node": "node scripts/copy-maplibre-worker.mjs && next build",
    "test": "bun test --isolate --timeout=30000 src/lib/ src/utilities/ src/hooks/ src/components/",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "dev": "node scripts/copy-maplibre-worker.mjs && bun run --bun next dev --turbo",
    "dev:node": "node scripts/copy-maplibre-worker.mjs && next dev --turbo",
    "start": "bun run --bun next start",
    "start:node": "next start",
    "test:unit": "bun run test",
    "typegen": "next typegen",
    "codegen": "node src/lib/api/graphcache-schema-codegen.ts"
  },
  "dependencies": {
    "@cellar-assistant/contracts": "workspace:*",
    "@cellar-assistant/schema": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.3.0",
    "@lexical/react": "0.52.0",
    "@mui/joy": "5.0.0-beta.52",
    "@tanstack/react-virtual": "3.14.13",
    "@urql/core": "6.0.3",
    "@urql/devtools": "2.0.3",
    "@urql/exchange-auth": "3.0.0",
    "@urql/exchange-graphcache": "^9.0.2",
    "@urql/next": "2.0.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xstate/react": "6.1.0",
    "barcode-detector": "3.2.2",
    "framer-motion": "14.0.0",
    "gql.tada": "catalog:",
    "graphql": "catalog:",
    "jose": "catalog:",
    "lexical": "0.52.0",
    "libphonenumber-js": "1.13.14",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.8",
    "nuqs": "^2.10.1",
    "ramda": "0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-icons": "5.7.0",
    "react-map-gl": "^8.1.3",
    "react-phone-number-input": "3.4.18",
    "react-qr-code": "2.2.0",
    "react-simple-star-rating": "5.1.7",
    "react-webcam": "7.2.0",
    "recharts": "3.10.1",
    "urql": "5.0.4",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@serwist/turbopack": "^9.5.13",
    "@types/geojson": "7946.0.16",
    "@types/node": "catalog:",
    "@types/ramda": "0.32.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "serwist": "^9.5.13",
    "typescript": "catalog:"
  }
}
